{
  "asyncapi": "2.6.0",
  "info": {
    "title": "Astronomy Observation Events",
    "version": "1.0.0",
    "description": "Real-time stream of telescope observation updates."
  },
  "channels": {
    "astronomy/observation/created": {
      "subscribe": {
        "summary": "Observation created",
        "operationId": "onObservationCreated",
        "message": {
          "contentType": "application/json",
          "payload": {
            "type": "object",
            "properties": {
              "observationId": { "type": "string" },
              "objectId": { "type": "string" },
              "timestamp": { "type": "string", "format": "date-time" }
            }
          }
        }
      }
    },
    "astronomy/observation/updated": {
      "subscribe": {
        "summary": "Observation updated",
        "operationId": "onObservationUpdated",
        "message": {
          "contentType": "application/json",
          "payload": {
            "type": "object",
            "properties": {
              "observationId": { "type": "string" },
              "changes": { "type": "object" }
            }
          }
        }
      }
    }
  }
}
