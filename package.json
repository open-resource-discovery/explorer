{
  "name": "@open-resource-discovery/explorer",
  "version": "0.2.1",
  "description": "A UI for exploring ORD (Open Resource Discovery) documents - browse, fetch, and merge resources.",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    "./components": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.mjs"
    },
    "./components/styles": {
      "types": "./dist/lib/styles.d.ts",
      "default": "./dist/lib/index.css"
    }
  },
  "homepage": "https://github.com/open-resource-discovery/explorer",
  "repository": {
    "type": "git",
    "url": "https://github.com/open-resource-discovery/explorer.git"
  },
  "bugs": {
    "url": "https://github.com/open-resource-discovery/explorer/issues"
  },
  "keywords": [
    "ord",
    "open-resource-discovery",
    "api",
    "explorer",
    "documentation"
  ],
  "author": "SAP SE",
  "type": "module",
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,yml,yaml,md,html,css}": [
      "prettier --write"
    ]
  },
  "scripts": {
    "dev": "vite --config app/vite.config.ts",
    "generate:sample": "node --experimental-strip-types scripts/generate-sample-doc.ts",
    "build": "npm run generate:sample && tsc -b && vite build --config app/vite.config.ts",
    "build:lib": "vite build --config app/vite.config.lib.ts && tsc --project app/tsconfig.lib.json",
    "prepack": "npm run build && npm run build:lib",
    "typecheck": "node node_modules/typescript/bin/tsc -b --noEmit",
    "lint": "npm run eslint:ci",
    "eslint": "eslint . --fix",
    "eslint:ci": "eslint .",
    "prettier": "prettier --write \"**/*.{ts,tsx,json,yml,yaml,md,html,css}\"",
    "prettier:ci": "prettier --check \"**/*.{ts,tsx,json,yml,yaml,md,html,css}\"",
    "format": "npm run prettier && npm run eslint",
    "format:check": "npm run prettier:ci && npm run eslint:ci",
    "preview": "vite preview --config app/vite.config.ts",
    "proxy": "node auth-proxy/dist/proxy.mjs",
    "test": "vitest run --coverage --config app/vitest.config.ts",
    "test:watch": "vitest --config app/vitest.config.ts",
    "test:coverage": "vitest run --coverage --config app/vitest.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "prepare": "husky",
    "setup:hooks": "husky"
  },
  "dependencies": {
    "@leeoniya/ufuzzy": "1.0.19",
    "@open-resource-discovery/ui-components": "0.3.1",
    "@open-resource-discovery/metadata-renderer": "1.1.3",
    "@tanstack/react-router": "1.170.46",
    "clsx": "2.1.1",
    "hono": "4.13.20",
    "lucide-react": "1.78.0",
    "react-markdown": "10.1.0",
    "tailwind-merge": "3.7.1",
    "undici": "8.13.1",
    "uuid": "14.0.3"
  },
  "overrides": {
    "@ai-sdk/provider-utils@4": "4.0.62",
    "dompurify": "3.4.17",
    "js-yaml": "5.5.0",
    "fast-uri": "4.2.3",
    "fast-xml-parser": "5.12.0",
    "seroval": "1.6.11",
    "undici@6": "6.29.1",
    "undici@7": "7.30.2",
    "vue": "3.5.45"
  },
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=11.11.1"
  },
  "devDependencies": {
    "@scalar/types": "0.32.0",
    "@eslint/js": "10.0.1",
    "@monaco-editor/react": "4.7.0",
    "@open-resource-discovery/specification": "1.17.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "jsdom": "31.0.1",
    "lint-staged": "17.6.2",
    "prettier": "3.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shiki": "4.6.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "zod": "4.6.7"
  },
  "packageManager": "npm@11.20.0",
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.20.0",
      "onFail": "error"
    }
  },
  "allowScripts": {
    "@scarf/scarf@1.4.0": false,
    "fsevents@2.3.3": false,
    "vue-demi@0.14.10": false
  }
}
