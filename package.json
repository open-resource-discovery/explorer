{
  "name": "@open-resource-discovery/explorer",
  "version": "0.2.1",
  "description": "A UI for exploring ORD (Open Resource Discovery) documents - browse, fetch, and merge resources.",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    "./components": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.mjs"
    },
    "./components/styles": "./dist/lib/index.css"
  },
  "homepage": "https://github.com/open-resource-discovery/explorer",
  "repository": {
    "type": "git",
    "url": "https://github.com/open-resource-discovery/explorer.git"
  },
  "bugs": {
    "url": "https://github.com/open-resource-discovery/explorer/issues"
  },
  "keywords": [
    "ord",
    "open-resource-discovery",
    "api",
    "explorer",
    "documentation"
  ],
  "author": "SAP SE",
  "type": "module",
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,yml,yaml,md,html,css}": [
      "prettier --write"
    ]
  },
  "scripts": {
    "dev": "vite --config app/vite.config.ts",
    "generate:sample": "node --experimental-strip-types scripts/generate-sample-doc.ts",
    "build": "npm run generate:sample && tsc -b && vite build --config app/vite.config.ts",
    "build:lib": "vite build --config app/vite.config.lib.ts && tsc --project app/tsconfig.lib.json",
    "prepack": "npm run build && npm run build:lib",
    "typecheck": "node node_modules/typescript/bin/tsc -b --noEmit",
    "lint": "npm run eslint:ci",
    "eslint": "eslint . --fix",
    "eslint:ci": "eslint .",
    "prettier": "prettier --write \"**/*.{ts,tsx,json,yml,yaml,md,html,css}\"",
    "prettier:ci": "prettier --check \"**/*.{ts,tsx,json,yml,yaml,md,html,css}\"",
    "format": "npm run prettier && npm run eslint",
    "format:check": "npm run prettier:ci && npm run eslint:ci",
    "preview": "vite preview --config app/vite.config.ts",
    "proxy": "node auth-proxy/dist/proxy.mjs",
    "test": "vitest run --coverage --config app/vitest.config.ts",
    "test:watch": "vitest --config app/vitest.config.ts",
    "test:coverage": "vitest run --coverage --config app/vitest.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "prepare": "husky"
  },
  "dependencies": {
    "@leeoniya/ufuzzy": "1.0.19",
    "@open-resource-discovery/ui-components": "0.3.0",
    "@open-resource-discovery/metadata-renderer": "1.0.1",
    "@tanstack/react-router": "1.170.41",
    "clsx": "2.1.1",
    "hono": "4.13.13",
    "lucide-react": "1.54.0",
    "react-markdown": "10.1.0",
    "tailwind-merge": "3.7.0",
    "undici": "8.11.2",
    "uuid": "14.0.2"
  },
  "overrides": {
    "@ai-sdk/provider-utils": "4.0.57",
    "dompurify": "3.4.16",
    "js-yaml": "5.4.2",
    "fast-uri": "3.1.8",
    "undici@7": "7.29.1",
    "brace-expansion@1": "1.1.21",
    "brace-expansion@>=2.0.0": "5.0.12"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@scalar/types": "0.22.4",
    "@eslint/js": "10.0.1",
    "@monaco-editor/react": "4.7.0",
    "@open-resource-discovery/specification": "1.16.4",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "25.9.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "jsdom": "30.1.2",
    "lint-staged": "17.6.0",
    "prettier": "3.9.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shiki": "4.5.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "zod": "4.6.5"
  }
}
