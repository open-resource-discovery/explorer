# Stage 1: build the esbuild bundle
FROM node:26.13.1-alpine@sha256:6bd9ab43c0ec0190ca7b2d193906cb8b7edf6e7f4afa43ddeccd6452710bffb5 AS builder
WORKDIR /app
COPY auth-proxy/package*.json .npmrc ./
RUN npm install --global --ignore-scripts npm@11.20.0 && npm ci
COPY auth-proxy/ .
RUN npm run build

# Stage 2: minimal runtime image
FROM node:26.13.1-alpine@sha256:6bd9ab43c0ec0190ca7b2d193906cb8b7edf6e7f4afa43ddeccd6452710bffb5
WORKDIR /app
COPY --from=builder /app/dist/proxy.mjs ./proxy.mjs
EXPOSE 44123
ENV PORT=44123
CMD ["node", "proxy.mjs"]
