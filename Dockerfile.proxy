# Stage 1: build the esbuild bundle
FROM node:22-alpine AS builder
WORKDIR /app
COPY auth-proxy/package*.json ./
RUN npm ci
COPY auth-proxy/ .
RUN npm run build

# Stage 2: minimal runtime image
FROM node:22-alpine
WORKDIR /app
COPY --from=builder /app/dist/proxy.mjs ./proxy.mjs
EXPOSE 44123
ENV PORT=44123
CMD ["node", "proxy.mjs"]
