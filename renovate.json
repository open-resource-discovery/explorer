{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":pinAllExceptPeerDependencies",
    "helpers:pinGitHubActionDigests",
    "docker:pinDigests"
  ],
  "semanticCommits": "enabled",
  "enabledManagers": ["npm", "github-actions", "dockerfile"],
  "branchPrefix": "deps/",
  "timezone": "Europe/Berlin",
  "schedule": ["every weekend"],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "vulnerabilityAlerts": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Security patches: bypass weekly schedule, automerge immediately",
      "schedule": ["at any time"],
      "automerge": true,
      "semanticCommitType": "fix",
      "groupName": "Security patches",
      "matchJsonata": ["isVulnerabilityAlert = true"]
    },
    {
      "description": "Major updates: never automerge, require manual review",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Runtime deps: ships to users",
      "groupName": "Runtime dependencies",
      "matchManagers": ["npm"],
      "matchDepTypes": ["dependencies"],
      "semanticCommitType": "chore",
      "automerge": true,
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "description": "Dev toolchain: never ships",
      "groupName": "Dev toolchain",
      "matchManagers": ["npm", "github-actions"],
      "matchDepTypes": ["devDependencies"],
      "semanticCommitType": "chore",
      "automerge": true,
      "matchUpdateTypes": ["minor", "patch"]
    }
  ]
}
